{
  "name": "hivocab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./css/hivocab.min.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./css/hivocab.min.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
