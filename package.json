{
  "name": "hivocab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "lint": "eslint src functions workers scripts",
    "format:check": "prettier --check eslint.config.js tsconfig.json src/config/runtime.js src/services/topicsService.js",
    "format": "prettier --write eslint.config.js tsconfig.json src/config/runtime.js src/services/topicsService.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-test.js && node scripts/unit-test.js",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./css/hivocab.min.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./css/hivocab.min.css --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
