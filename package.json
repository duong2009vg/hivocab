{
  "name": "hivocab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "test": "node scripts/smoke-test.js && node scripts/unit-test.js",
    "test:e2e": "playwright test",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./css/hivocab.min.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/app.css -o ./css/hivocab.min.css --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5"
  }
}
