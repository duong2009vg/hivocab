{
  "manifest_version": 3,
  "name": "Hi Vocabulary Clipper",
  "version": "0.1.0",
  "description": "Tra nhanh từ đang bôi đen và thêm vào Hi - Master Vocabulary.",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Hi Vocabulary Clipper" }
}
